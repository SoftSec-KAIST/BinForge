#!/bin/bash

COMPILER_BINARY="${BinForge}/tools/clang/${clang-ver}/bin/_clang"
CONFTEST_SOURCE="${BinForge}/patches/conftest/conftest.c"

if [[ "$*" != *"--print-multiarch"* ]]; then
    # clang++ and clang-cl may be symlinks to clang; Clang selects its driver
    # mode from argv[0], so preserve the name used to call the wrapper.
    exec -a "$0" "$COMPILER_BINARY" "$@"
fi

target="x86_64-linux-gnu"
for arg in "$@"; do
    if [[ $arg == --target=* ]]; then
        target="${arg#--target=}"
    fi
done

if ! preprocessed=$("$COMPILER_BINARY" --target="$target" -E "$CONFTEST_SOURCE"); then
    exit 1
fi
multiarch=$(printf '%s\n' "$preprocessed" | grep -v '^#' | grep -v '^[[:space:]]*$' | tr -d ' \t\r\n')
if [[ -z "$multiarch" ]]; then
    echo "Could not determine multiarch for $target" >&2
    exit 1
fi
printf '%s\n' "$multiarch"
